rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===== Helpers =====
    function signedIn() {
      return request.auth != null;
    }

    function myEmail() {
      return request.auth.token.email.lower();
    }

    function myRole() {
      return get(/databases/$(database)/documents/roles/$(myEmail())).data.role;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(myEmail()))
        && myRole() == 'super';
    }

    function isWriter() {
      return signedIn()
        && exists(/databases/$(database)/documents/roles/$(myEmail()))
        && (myRole() == 'super' || myRole() == 'writer');
    }

    function isBlocked() {
      return signedIn()
        && exists(/databases/$(database)/documents/settings/site)
        && myEmail() in get(/databases/$(database)/documents/settings/site).data.blockedEmails;
    }

    // ===== roles/{email} — מי מנהל-על, מי כותב =====
    match /roles/{email} {
      allow get: if signedIn() && (isSuperAdmin() || email == myEmail());
      allow list: if isSuperAdmin();
      allow write: if isSuperAdmin();
    }

    // ===== settings/site — רשימת חסומים, הגדרות כלליות =====
    match /settings/site {
      allow get: if signedIn();
      allow write: if isSuperAdmin();
    }

    // ===== posts/{postId} — הפיד =====
    match /posts/{postId} {
      allow read: if signedIn() && !isBlocked();
      allow create: if signedIn() && !isBlocked() && isWriter()
                    && request.resource.data.authorEmail == myEmail();
      // עדכון פתוח לכל משתמש לא-חסום כדי לאפשר ריאקציות; מחיקה רק לכותבים/מנהלים
      allow update: if signedIn() && !isBlocked();
      allow delete: if isWriter();

      // ===== תגובות על פוסט =====
      match /comments/{commentId} {
        allow read: if signedIn() && !isBlocked();
        allow create: if signedIn() && !isBlocked()
                      && request.resource.data.authorEmail == myEmail();
        allow delete: if signedIn() && (isSuperAdmin() || resource.data.authorEmail == myEmail());
      }
    }

    // ===== announcements/{id} — הודעות מנהל, כולם קוראים, רק כותבים שולחים =====
    match /announcements/{id} {
      allow read: if signedIn() && !isBlocked();
      allow create: if signedIn() && !isBlocked() && isWriter()
                    && request.resource.data.authorEmail == myEmail();
      allow delete: if signedIn() && (isSuperAdmin() || (isWriter() && resource.data.authorEmail == myEmail()));
    }
  }
}
